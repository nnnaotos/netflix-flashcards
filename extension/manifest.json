{
  "manifest_version": 3,
  "name": "Netflix Phrase Capture",
  "version": "0.1.0",
  "description": "Netflix の字幕からフレーズを拾って Notion に送る",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.netflix.com/*",
    "https://*.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}
